{
  "name": "maduser/argon-prophecy",
  "description": "A strict, DI-first and PSR-compliant PHP runtime, for the law-abiding Prophets.",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Maduser\\Argon\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Julien Duseyau",
      "email": "julien.duseyau@gmail.com"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "~/workspace/argon/packages/maduser-argon"
    },
    {
      "type": "path",
      "url": "~/workspace/argon/packages/maduser-argon-routing"
    },
    {
      "type": "path",
      "url": "~/workspace/argon/packages/maduser-argon-middleware"
    },
    {
      "type": "path",
      "url": "~/workspace/argon/packages/maduser-argon-view"
    }
  ],
  "require": {
    "maduser/argon": "dev-master",
    "maduser/argon-middleware": "dev-master",
    "maduser/argon-routing": "dev-master",
    "maduser/argon-view": "dev-master",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "ext-pcntl": "*",
    "ext-posix": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "filp/whoops": "^2.18",
    "guzzlehttp/guzzle": "^7.9",
    "illuminate/database": "12.6.*",
    "monolog/monolog": "^3.9",
    "phpunit/phpunit": "^10.5.45",
    "slevomat/coding-standard": "^8.16",
    "squizlabs/php_codesniffer": "^3.8",
    "symfony/var-dumper": "^7.2",
    "twig/twig": "^3.20",
    "vimeo/psalm": "^5.26",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload-dev": {
    "psr-4": {
      "App\\": "tests/application/app/src/",
      "Tests\\Application\\": "tests/application/tests/",
      "Tests\\Unit\\": "tests/unit/",
      "Tests\\Integration\\": "tests/integration/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs --standard=phpcs.xml",
    "phpcs:fix":"vendor/bin/phpcbf --standard=phpcs.xml",
    "psalm": "vendor/bin/psalm --output-format=github",
    "psalm:clear": "vendor/bin/psalm --clear-cache",
    "test": "vendor/bin/phpunit",
    "test:coverage": "mkdir -p storage/phpunit/coverage/html && vendor/bin/phpunit --coverage-html storage/phpunit/coverage/html --coverage-clover storage/phpunit/coverage/clover.xml && open storage/phpunit/coverage/html/index.html",
    "ti": "vendor/bin/phpunit --testsuite=unit",
    "tu": "vendor/bin/phpunit --testsuite=unit",
    "watch": "find src/ | entr -r composer check",
    "watch:test": "find src/ | entr -r composer test",
    "watch:fix": "find src/ | entr -r composer phpcs:fix",
    "check": ["@test:coverage", "@psalm", "@phpcs:fix", "@phpcs"],
    "ci": ["@test", "@psalm", "@phpcs"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "MIT"
}
